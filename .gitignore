.DS_Store
old_data/
__pycache__/
.env

# Derived artifacts (regenerable from source) — see CLAUDE.md commit policy.
.cache/
# results/ holds experiment outputs; they are committed (no personal data). Only the
# private audit stays out, and it lives in data/private/.
results/*
!results/eval-*.json
!results/privacy_metrics.json
# The v2 description pilot: public glyphs and generated text only (scripts/v2_pilot.py).
!results/v2_pilot/
# v2 statistics and the blind QA (scripts/v2_report.py, v2_qa.py): public glyphs and
# generated text only. The contact sheets are regenerated by `v2_qa.py sheets`.
!results/v2_stats/
!results/v2_qa/
results/v2_qa/judging/*.png
data/eval/*_tasks.jsonl
*.npz

# Private data: personal tasks, their labels, style stats. Never commit.
data/private/
# Downloaded third-party corpora (re-fetch with scripts/datasets/fetch_public.py).
data/raw/

# Labelling bundle (built by scripts/build_label_bundle.py; contains private tasks) and labels.
labeller/bundle/
labeller/labels/
