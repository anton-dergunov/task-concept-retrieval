{
    // The data folders hold ~50 GB and no code: keep Pylance and the file watcher out of them.
    "python.analysis.exclude": ["**/.venv", "data", "old_data", "results"],
    "files.watcherExclude": {
        "**/.venv/**": true,
        "data/**": true,
        "old_data/**": true,
        "results/**": true
    }
}
